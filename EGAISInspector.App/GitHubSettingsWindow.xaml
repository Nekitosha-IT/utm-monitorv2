<Window x:Class="EGAISInspector.App.GitHubSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GitHub диагностика" Width="560" Height="330" MinWidth="500" MinHeight="300"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="GitHub диагностика" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Text="Репозиторий: Nekitosha-IT/utm-monitorv2" Margin="0,10,0,16" Opacity="0.75"/>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Fine-grained GitHub token" Margin="0,0,0,6"/>
            <PasswordBox x:Name="TokenBox" Height="34" Padding="8"/>
            <TextBlock Text="Нужен доступ Contents: Read and write только к этому репозиторию. Токен хранится в Windows DPAPI и не попадает в лог." TextWrapping="Wrap" Margin="0,8,0,0" Opacity="0.7"/>
        </StackPanel>

        <TextBlock Grid.Row="3" x:Name="StatusText" TextWrapping="Wrap" Margin="0,12,0,0" VerticalAlignment="Top"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Удалить токен" Click="Delete_Click" Padding="14,8" Margin="0,0,8,0"/>
            <Button Content="Отмена" Click="Cancel_Click" Padding="14,8" Margin="0,0,8,0"/>
            <Button Content="Сохранить" Click="Save_Click" Padding="14,8"/>
        </StackPanel>
    </Grid>
</Window>
