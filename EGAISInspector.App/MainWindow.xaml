<Window x:Class="EGAISInspector.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="EGAIS Inspector" MinWidth="800" MinHeight="600" UseLayoutRounding="True" SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen">
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid Grid.ColumnSpan="2" Margin="0,0,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="EGAIS Inspector" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" Text="{Binding UpdateStatus}" VerticalAlignment="Center" Margin="0,0,12,0" Opacity="0.75"/>
      <Button Grid.Column="2" Content="⟳ Автообновление" Command="{Binding AutoUpdateCommand}" Padding="14,8"/>
    </Grid>
    <Border Grid.Row="1" Background="{DynamicResource CardBackground}" CornerRadius="14" Padding="12" Margin="0,0,14,0">
      <ListBox ItemsSource="{Binding NavigationItems}" SelectedIndex="0" Width="190"/>
    </Border>
    <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Дашборд" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,16"/>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="УТМ"/><TextBlock Text="{Binding UtmStatus}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding Organization}"/></StackPanel></Border>
          <Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="FSRAR_ID"/><TextBlock Text="{Binding FsrarId}" FontSize="20"/></StackPanel></Border>
          <Border Grid.Column="2" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Версия УТМ"/><TextBlock Text="{Binding UtmVersion}" FontSize="20"/></StackPanel></Border>
          <Border Grid.Column="3" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="RSA"/><TextBlock Text="{Binding CertificateDays, StringFormat=Осталось {0} дн.}" FontSize="20"/></StackPanel></Border>
        </Grid>
        <Grid Grid.Row="2" Margin="0,16,0,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8"><StackPanel><TextBlock Text="Последние события" FontSize="20" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding Events}" Margin="0,10,0,0"/></StackPanel></Border>
          <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,8,0,0">
            <StackPanel>
              <TextBlock Text="AI Диагностика и логи" FontSize="20" FontWeight="SemiBold"/>
              <TextBlock Text="Программа сохраняет диагностические события. По этим логам будем находить реальные проблемы и дорабатывать ЕГАИС Inspector." TextWrapping="Wrap" Margin="0,8,0,12"/>
              <TextBlock Text="{Binding LogStatus}" Opacity="0.75" TextWrapping="Wrap" Margin="0,0,0,6"/>
              <TextBlock Text="{Binding DiagnosticsStatus}" Opacity="0.85" TextWrapping="Wrap" Margin="0,0,0,12"/>
              <WrapPanel>
                <Button Content="Отправить диагностику" Command="{Binding UploadDiagnosticsCommand}" Padding="14,8" Margin="0,0,10,8"/>
                <Button Content="Настроить GitHub" Command="{Binding ConfigureGitHubDiagnosticsCommand}" Padding="14,8" Margin="0,0,10,8"/>
                <Button Content="Открыть папку логов" Command="{Binding OpenLogFolderCommand}" Padding="14,8" Margin="0,0,10,8"/>
                <Button Content="Запустить автообновление" Command="{Binding AutoUpdateCommand}" Padding="14,8" Margin="0,0,10,8"/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>
