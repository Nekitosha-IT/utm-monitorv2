<Window x:Class="EGAISInspector.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="EGAIS Inspector" MinWidth="800" MinHeight="600" Width="1100" Height="720" UseLayoutRounding="True" SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="Border" x:Key="Card">
      <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="18"/>
      <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="FontSize" Value="15"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>
  </Window.Resources>

  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

    <Grid Margin="0,0,0,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="EGAIS Inspector" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock Text="УТМ + проверка акцизной марки" Opacity="0.7" Margin="0,3,0,0"/>
      </StackPanel>
      <Button Grid.Column="1" Content="＋ Добавить УТМ" Command="{Binding AddUtmCommand}" VerticalAlignment="Center"/>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource Card}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Активный УТМ" FontWeight="SemiBold"/>
          <ComboBox ItemsSource="{Binding Utms}" SelectedItem="{Binding SelectedUtm}" DisplayMemberPath="Name" Margin="0,7,10,0" Height="34"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="14,0,14,0">
          <TextBlock Text="Соединение" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding ConnectionStatus}" FontSize="18" Margin="0,7,0,0"/>
          <TextBlock Text="{Binding Organization}" Opacity="0.75" Margin="0,2,0,0"/>
        </StackPanel>
        <Button Grid.Column="2" Content="⟳ Обновить" Command="{Binding RefreshUtmCommand}" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}" Grid.Column="0" Margin="0,0,7,14"><StackPanel><TextBlock Text="FSRAR_ID" Opacity="0.7"/><TextBlock Text="{Binding FsrarId}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Grid.Column="1" Margin="7,0,7,14"><StackPanel><TextBlock Text="Версия УТМ" Opacity="0.7"/><TextBlock Text="{Binding UtmVersion}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Grid.Column="2" Margin="7,0,0,14"><StackPanel><TextBlock Text="Очередь" Opacity="0.7"/><TextBlock Text="{Binding QueueStatus}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></Border>
        </Grid>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Акцизная марка" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Вставь полный DataMatrix. Программа разберёт тип/серию/номер и отправит QueryBarcode непосредственно в УТМ." Opacity="0.72" TextWrapping="Wrap" Margin="0,5,0,12"/>
            <TextBox Text="{Binding MarkInput, UpdateSourceTrigger=PropertyChanged}" MinHeight="80" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,8">
              <Button Content="Проверить марку через УТМ" Command="{Binding QueryMarkCommand}" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding MarkStatus}" VerticalAlignment="Center" Opacity="0.8" TextWrapping="Wrap"/>
            </StackPanel>
            <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="12" MaxHeight="260">
              <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding MarkResult}" FontFamily="Consolas" TextWrapping="Wrap"/></ScrollViewer>
            </Border>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,4">
          <StackPanel>
            <TextBlock Text="Связь с УТМ" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Используются реальные HTTP-запросы к /api/info/list, /opt/out и /opt/in. Поддержаны запросы Form A, Form B, история B и остатки на уровне Core для дальнейшего расширения без возврата старого интерфейса." TextWrapping="Wrap" Opacity="0.75" Margin="0,6,0,0"/>
            <TextBlock Text="RSA: {Binding RsaStatus}" TextWrapping="Wrap" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
